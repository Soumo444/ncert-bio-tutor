# ---------------------------------------------------------------------------
# Copy this file to `.env` and paste ONE free API key.
#   copy .env.example .env
# ---------------------------------------------------------------------------

# Embeddings + backup answers. Free key, no credit card:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model ids (checked against the live API in Nov 2026).
# NOTE: gemini Pro models have zero free-tier quota on new keys.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_STRONG=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_THINKING_BUDGET=0

# Primary provider. Groq's gpt-oss-120b is the strongest model that is both
# free and fast (~1 s) on this machine. Gemini is the automatic fallback.
# Groq key: https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_FALLBACKS=gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Fast mode uses light reasoning; Strong mode thinks harder and gets a bigger
# token budget so the visible answer is never cut off by hidden reasoning.
GROQ_REASONING_FAST=low
GROQ_REASONING_STRONG=medium
GROQ_MAX_TOKENS_STRONG=3000

# Optional third provider: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Embeddings - cloud, free tier, nothing downloaded
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Free tier counts every text as a request, 100 per minute. 30 per batch +
# the pause keeps ingestion just under the cap instead of getting 429s.
EMBED_BATCH_SIZE=30
EMBED_SLEEP_SECONDS=21

# Answer behaviour
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=1200
# Second model call that checks the answer against the context
GROUNDEDNESS_CHECK=true
# Run the judge on a different provider so it has its own free quota
JUDGE_PROVIDER=gemini
# auto = ChatGPT-style: documents when relevant + labelled general knowledge
# docs = strict: refuse when the documents do not contain the answer
ANSWER_MODE=auto

# Retrieval
TOP_K=6
MIN_SCORE=0.20
USE_MMR=true
MMR_LAMBDA=0.6

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150
CSV_ROWS_PER_CHUNK=15

# Server
HOST=127.0.0.1
PORT=8000

# Public deployment
# READ_ONLY_MODE=true disables uploads, reindexing and deletes (good for a demo).
READ_ONLY_MODE=false
# Per-IP chat limit per hour. 0 = unlimited.
RATE_LIMIT_PER_HOUR=0
